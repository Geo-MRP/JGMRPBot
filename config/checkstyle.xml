<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <!--
        WARNING: Do NOT add FileTabCharacter here.
        Spotless handles our tabs.
    -->

    <module name="TreeWalker">

        <!-- =============================================================== -->
        <!-- NAMING CONVENTIONS                                              -->
        <!-- =============================================================== -->

        <!-- Classes and Interfaces must be PascalCase (e.g., PingCommand) -->
        <module name="TypeName"/>

        <!-- Methods must be camelCase (e.g., executeCommand) -->
        <module name="MethodName"/>

        <!-- Local variables must be camelCase -->
        <module name="LocalVariableName"/>

        <!-- Constants (static final) must be ALL_CAPS_WITH_UNDERSCORES -->
        <module name="ConstantName"/>

        <!-- =============================================================== -->
        <!-- STRUCTURAL INTEGRITY & BEST PRACTICES                           -->
        <!-- =============================================================== -->

        <!-- Prevent unused imports from cluttering the top of the file -->
        <module name="UnusedImports"/>

        <!-- Prevent empty catch blocks (swallowing exceptions silently) -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
        </module>

        <!-- Stop developers from writing massive, unreadable methods -->
        <module name="MethodLength">
            <property name="max" value="150"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- Require switch statements to always have a default case -->
        <module name="MissingSwitchDefault"/>

    </module>
</module>